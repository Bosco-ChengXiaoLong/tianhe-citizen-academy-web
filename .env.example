# mock 使用演示数据，api 使用 Java 后台接口。
VITE_DATA_SOURCE=mock
# 管理后台请求的 API 路径前缀。
VITE_API_BASE_URL=/api/admin/v1
# Vite 开发服务器转发 API 请求的 Java 地址。
API_PROXY_TARGET=http://127.0.0.1:8080
# Compose 部署使用的管理后台镜像名和标签。
FRONTEND_IMAGE=qingmu-academy-admin:local
# 管理后台容器映射到宿主机的端口。
ADMIN_PORT=19080
# 后台容器和 Java API 容器共用的 Docker 网络。
SERVICE_NETWORK=qingmu-academy-internal
# 容器内 Nginx 转发 API 的 Java 服务地址。
JAVA_UPSTREAM=qingmu-java:8080
