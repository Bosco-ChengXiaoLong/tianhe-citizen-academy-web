{
  "name": "@qingmu-academy/admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5188 --strictPort",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4188 --strictPort",
    "test": "vitest run",
    "check": "npm run format:check && npm run typecheck && npm run test && npm run build",
    "verify:ui": "node tests/browser.mjs",
    "format": "prettier --write src tests *.ts *.json *.html",
    "format:check": "prettier --check src tests *.ts *.json *.html",
    "dev:mock": "vite --mode mock",
    "dev:api": "vite --mode api",
    "build:mock": "vue-tsc --noEmit && vite build --mode mock",
    "build:api": "vue-tsc --noEmit && vite build --mode api"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "element-plus": "2.14.7",
    "pinia": "4.1.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "3.5.44",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@types/node": "22.19.0",
    "@vitejs/plugin-vue": "6.0.10",
    "playwright": "1.64.1",
    "prettier": "^3.9.10",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "^5.0.5",
    "vue-tsc": "3.3.14"
  }
}
