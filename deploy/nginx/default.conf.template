server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 3m;
    add_header Cache-Control $cache_control always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" always;
    location = /healthz {
        default_type application/json;
        return 200 '{"status":"UP","app":"admin"}';
    }
    # Preserve the original path/query and use Docker DNS at request time.
    location ^~ /api/ {
        resolver 127.0.0.11 valid=10s ipv6=off;
        resolver_timeout 2s;
        set $java_backend http://${JAVA_UPSTREAM};
        proxy_pass $java_backend$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $external_scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 3s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        proxy_cache off;
        proxy_buffering off;
        proxy_intercept_errors off;
        error_page 502 504 = @api_unavailable;
    }
    location @api_unavailable {
        default_type application/json;
        return 503 '{"code":"SERVICE_UNAVAILABLE","message":"Java service unavailable","data":null}';
    }
    location = /api { return 404; }

    # Administrative requests are authenticated by Java.
    location ~ ^/(internal|actuator|swagger-ui|swagger-ui.html|v3/api-docs)(/|$) { return 404; }
    location ~ /\. { return 404; }
    location /assets/ { try_files $uri =404; }
    location ~* \.(js|css|map|json|png|jpe?g|gif|svg|ico|woff2?|ttf|webp|avif)$ { try_files $uri =404; }
    location / { try_files $uri $uri/ /index.html; }
}
